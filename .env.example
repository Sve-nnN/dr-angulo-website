# URL pública del sitio (usar la URL real de Vercel o el dominio final cuando exista)
NEXT_PUBLIC_SITE_URL=https://dr-angulo.vercel.app

# Google Analytics 4 — Measurement ID (G-XXXXXXX). Si se deja vacío, GA4 no se carga.
NEXT_PUBLIC_GA_ID=

# Meta Pixel ID. Si se deja vacío, el pixel no se carga.
NEXT_PUBLIC_META_PIXEL_ID=

# Resend — https://resend.com. Si se deja vacío, el formulario de contacto
# sigue funcionando (el paciente puede continuar por WhatsApp), pero no se
# envía el email de notificación/confirmación.
RESEND_API_KEY=
# Remitente verificado en Resend. Mientras no haya dominio propio verificado,
# se puede usar el remitente de pruebas: "Dr. Juan Angulo <onboarding@resend.dev>"
EMAIL_FROM="Dr. Juan Angulo <onboarding@resend.dev>"
# Correo del consultorio donde llegan las nuevas consultas del formulario
CONTACT_EMAIL_TO=
