# URL pública del sitio, sin barra final. En producción es el dominio propio.
# Si falta, siteConfig.url cae a https://drangulocolumna.com.
NEXT_PUBLIC_SITE_URL=https://drangulocolumna.com

# Google Analytics 4 — Measurement ID (G-XXXXXXX). Si se deja vacío, GA4 no se carga.
NEXT_PUBLIC_GA_ID=

# Meta Pixel ID. Si se deja vacío, el pixel no se carga.
NEXT_PUBLIC_META_PIXEL_ID=

# Resend — https://resend.com. Si se deja vacío, el formulario de contacto
# sigue funcionando (el paciente puede continuar por WhatsApp), pero no se
# envía el email de notificación/confirmación.
RESEND_API_KEY=
# Remitente verificado en Resend. Valor de producción acordado en D-05, una vez
# que el dominio propio esté verificado en Resend:
#   EMAIL_FROM="Dr. Juan Angulo <web@drangulocolumna.com>"
# Mientras tanto sirve el remitente de pruebas de Resend.
EMAIL_FROM="Dr. Juan Angulo <onboarding@resend.dev>"
# Casilla del doctor donde llegan las nuevas consultas del formulario. La define
# Juan; si se deja vacía, la consulta no se despacha a nadie y queda registrada
# en el log del servidor con el prefijo [contact].
CONTACT_EMAIL_TO=
